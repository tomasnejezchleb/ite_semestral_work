from machine import Pin, I2C, deepsleep, reset_cause, DEEPSLEEP_RESET
from esp32 import wake_on_ext0
import network
import urequests
import time

# ====== NASTAVENÍ ======
WIFI_SSID = "cuky"
WIFI_PASS = "tomas_335"
WEBHOOK_URL = "https://ntfy.sh/fall_detection_9fk3a8DQ"

I2C_SDA = 21
I2C_SCL = 22
MPU_ADDR = 0x68
INT_PIN = 32
RLED_PIN = 27  # LED pro vizuální indikaci

# ====== PINY ======
rled = Pin(RLED_PIN, Pin.OUT)
int_pin = Pin(INT_PIN, Pin.IN, Pin.PULL_UP)

# ====== I2C INIT ======
i2c = I2C(0, scl=Pin(I2C_SCL), sda=Pin(I2C_SDA), freq=400000)

# ====== MPU FUNKCE ======
def write_reg(reg, val):
    i2c.writeto_mem(MPU_ADDR, reg, bytes([val]))

def read_reg(reg):
    return i2c.readfrom_mem(MPU_ADDR, reg, 1)[0]

def mpu_init():
    print("Inicializace MPU")

    # Probuzení MPU
    write_reg(0x6B, 0x00)
    time.sleep(0.1)

    # Akcelerometr ±2g
    write_reg(0x1C, 0x00)

    # Motion threshold (citlivost)
    write_reg(0x1F, 10)

    # Motion duration
    write_reg(0x20, 1)

    # Povolit motion interrupt
    write_reg(0x38, 0x40)

    # Interrupt pin aktivní LOW, latched
    write_reg(0x37, 0x30)

    # Vymazat starý interrupt
    read_reg(0x3A)

# ====== WIFI ======
def connect_wifi():
    wlan = network.WLAN(network.STA_IF)
    wlan.active(True)
    wlan.disconnect()
    wlan.connect(WIFI_SSID, WIFI_PASS)

    timeout = 20
    while timeout > 0:
        if wlan.isconnected():
            print("IP:", wlan.ifconfig()[0])
            return True
        time.sleep(1)
        print("Čekám na WiFi...")
        timeout -= 1
    return False

# ====== ODESLÁNÍ ZPRÁVY ======
def send_notification():
    try:
        r = urequests.get(WEBHOOK_URL)
        print("Zpráva odeslána:", r.status_code)
        r.close()
    except Exception as e:
        print("Chyba při odesílání:", e)

# ====== HLAVNÍ LOGIKA ======
# Nastavení wake-up z deep sleep přes EXT0 (aktivní LOW)
wake_on_ext0(pin=int_pin, level=0)

mpu_init()

if reset_cause() == DEEPSLEEP_RESET:
    print("Probuzení z MPU interruptu")

    # Vyčistit interrupt
    status = read_reg(0x3A)
    print("INT status:", status)

    if status & 0x40:  # motion interrupt
        rled.on()  # rozsvítit LED
        if connect_wifi():
            send_notification()
        time.sleep(1)
        rled.off()
else:
    print("První spuštění – čekám na pohyb")

# ====== TESTOVACÍ SMYČKA detekce pohybu ======
while True:
    status = read_reg(0x3A)
    if status & 0x40:  # motion interrupt bit
        print("Motion detected!")
        rled.on()  # LED svítí při detekci
        if connect_wifi():
            send_notification()
        time.sleep(1)  # LED nech chvíli svítit
        rled.off()
        break
    time.sleep(0.1)

print("Jdu do deep sleep...")
time.sleep(1)
deepsleep()
