import network
import urequests
from machine import Pin, I2C, deepsleep
import time
from esp32 import wake_on_ext0
from machine import Pin, PWM

# --- Piny ---
I2C_SDA = 21
I2C_SCL = 22
MPU_ADDR = 0x68
INT_PIN = 4
RLED_PIN = 27
BUZZER_PIN = 25

# --- Wi-Fi ---
SSID = "SSID"
PASSWORD = "PASSWORD"
NTFY_URL = "NTFY_URL" 

# --- Inicializace ---
i2c = I2C(0, scl=Pin(I2C_SCL), sda=Pin(I2C_SDA))
rled = Pin(RLED_PIN, Pin.OUT)
rled.value(0)
buzz = PWM(Pin(BUZZER_PIN))
buzz.freq(1500)
buzz.duty(0)


# --- MPU6050 registry ---
PWR_MGMT_1 = 0x6B
INT_ENABLE = 0x38
MOT_THR = 0x1F
MOT_DUR = 0x20
INT_PIN_CFG = 0x37
INT_STATUS = 0x3A
ACCEL_XOUT_H = 0x3B
ACCEL_CONFIG = 0x1C

# --- Probuzení MPU ---
i2c.writeto_mem(MPU_ADDR, PWR_MGMT_1, bytes([0x00]))
i2c.writeto_mem(MPU_ADDR, 0x6B, bytes([0]))
i2c.writeto_mem(MPU_ADDR, 0x6C, bytes([0b00000111]))  # gyro X,Y,Z vypnuto, ACC zapnut

# --- Motion interrupt ---
i2c.writeto_mem(MPU_ADDR, MOT_THR, bytes([1]))
i2c.writeto_mem(MPU_ADDR, MOT_DUR, bytes([2]))
i2c.writeto_mem(MPU_ADDR, INT_ENABLE, bytes([0x40])) 
i2c.writeto_mem(MPU_ADDR, INT_PIN_CFG, bytes([0x20]))
i2c.writeto_mem(MPU_ADDR, ACCEL_CONFIG, bytes([0x00]))


#  --- Vector calculator ---
def to_int16(high, low):
    value = (high << 8) | low
    if value & 0x8000:
        value -= 0x10000
    return value

def read_accel_g():
    data = i2c.readfrom_mem(MPU_ADDR, ACCEL_XOUT_H, 6)

    ax = to_int16(data[0], data[1])
    ay = to_int16(data[2], data[3])
    az = to_int16(data[4], data[5])

    return (
        ax / 16384.0,
        ay / 16384.0,
        az / 16384.0
    )

# --- Kontrola probuzení ---
print("ESP probuzeno, kontrola pohybu...")
status = i2c.readfrom_mem(MPU_ADDR, INT_STATUS, 1)[0]
if status & 0x40:

  print ("Motion interrupt")

  # pauza pro ustálení
  time.sleep(1)

  fall_votes = 0
  valid_fall = False

  for _ in range(10):

    ax, ay, az = read_accel_g()

    print("ax=", ax, "ay=", ay, "az=", az)

    if abs(ay) <0.5:
      fall_votes += 1

    if fall_votes >=7:
      valid_fall = True
      print("Pád potvrzen")
      break
    time.sleep_ms(100)

  if not valid_fall:
    print("sekundární ověření nepotvrdilo pád")

  else:
    rled.value(1)
    buzz.freq(1500)
    buzz.duty(800)
    time.sleep(5)
    rled.value(0)
    buzz.duty(0)

    # --- Připojení k Wi-Fi ---
    print("Připojuji se k Wi-Fi...")
    wlan = network.WLAN(network.STA_IF)
    wlan.active(True)
    if not wlan.isconnected():
        wlan.connect(SSID, PASSWORD)
        timeout = 180
        while not wlan.isconnected() and timeout > 0:
            time.sleep(1)
            timeout -= 1

    if wlan.isconnected():
        print("Wi-Fi připojeno:", wlan.ifconfig())
        try:
            r = urequests.post(NTFY_URL, data="Fall detected!")
            r.close()
            print("Notifikace odeslána")
        except Exception as e:
            print("Chyba při odesílání notifikace:", e)
    else:
        print("Nepodařilo se připojit k Wi-Fi.")

# --- Vyčistíme interrupt registr ---
i2c.readfrom_mem(MPU_ADDR, INT_STATUS, 1)

print("ESP jde do deep sleep a čeká na další pohyb...")
ext_pin = Pin(INT_PIN, Pin.IN)
wake_on_ext0(pin=ext_pin, level=Pin.WAKE_HIGH)
deepsleep()
