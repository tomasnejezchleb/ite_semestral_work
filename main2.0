from machine import Pin, PWM
from time import sleep, ticks_ms, ticks_diff
from MPU6050 import MPU6050
import network
import urequests
import gc

# ================= WIFI =================
SSID = "cuky"
PASSWORD = "tomas_335"
NTFY_URL = "https://ntfy.sh/fall_detection_9fk3a8DQ"

WIFI_TIMEOUT = 10   # Timeout pro připojení WiFi v sekundách
MAX_RETRIES = 10    # Počet pokusů o odeslání notifikace
RETRY_DELAY = 1     # Čas mezi pokusy v sekundách
WIFI_KEEP_ON = 10   # Počet sekund, po které WiFi zůstane zapnutá po alarmu

wlan = None  # globální WiFi objekt

def connect_wifi(timeout_s=WIFI_TIMEOUT):
    global wlan
    if wlan is None:
        wlan = network.WLAN(network.STA_IF)
    wlan.active(True)
    if not wlan.isconnected():
        wlan.connect(SSID, PASSWORD)
        t0 = ticks_ms()
        while not wlan.isconnected():
            if ticks_diff(ticks_ms(), t0) > timeout_s * 1000:
                print("WiFi timeout")
                return None
            sleep(0.5)
    print("WiFi připojeno:", wlan.ifconfig())
    return wlan

def disconnect_wifi():
    global wlan
    if wlan and wlan.isconnected():
        wlan.disconnect()
        wlan.active(False)
        print("WiFi vypnuta")

def send_ntfy(title="FALL", message="Detekován pád!"):
    wlan = connect_wifi()
    if not wlan:
        print("Nepodařilo se připojit WiFi")
        return False

    for attempt in range(1, MAX_RETRIES + 1):
        try:
            headers = {"Title": title, "Priority": "5"}
            response = urequests.post(NTFY_URL, data=message, headers=headers)
            response.close()
            print(f"Notifikace odeslána ✓ (pokus {attempt})")
            return True
        except Exception as e:
            print(f"Chyba odesílání (pokus {attempt}/{MAX_RETRIES}):", e)
            sleep(RETRY_DELAY)
    print("Nepodařilo se odeslat notifikaci po všech pokusech")
    return False

# ================= HARDWARE =================

mpu = MPU6050()
rled = Pin(27, Pin.OUT)
gled = Pin(26, Pin.OUT)
buzzer = PWM(Pin(25))
buzzer.duty(0)

alarm_active = False
wifi_timer = 0  # Sleduje, dokud má WiFi zůstat zapnutá

def btn_cancel_handler(pin):
    global alarm_active, wifi_timer
    if alarm_active:
        print("Alarm zrušen tlačítkem")
        alarm_active = False
        rled.off()
        buzzer.duty(0)
        gled.on()

        # Po zrušení alarmu držíme WiFi zapnutou
        wifi_timer = WIFI_KEEP_ON

        # Odeslání notifikace o zrušení alarmu
        if send_ntfy(title="FALL CANCELED", message="Alarm zrušen tlačítkem"):
            print("Notifikace o zrušení odeslána")
        else:
            print("Nepodařilo se odeslat notifikaci o zrušení")

btn_cancel = Pin(33, Pin.IN, Pin.PULL_UP)
btn_cancel.irq(trigger=Pin.IRQ_FALLING, handler=lambda pin: (sleep(0.05), btn_cancel_handler(pin)))

def heartbeat():
    gled.on()
    sleep(0.5)
    gled.off()

# ================= MAIN LOOP =================
loop_counter = 0

try:
    while True:
        accel_data = mpu.read_accel_data(g=True)
        gyro_data = mpu.read_gyro_data()

        gx, gy, gz = abs(gyro_data['x']), abs(gyro_data['y']), abs(gyro_data['z'])
        g_force = (accel_data['x']**2 + accel_data['y']**2 + accel_data['z']**2) ** 0.5
        rotation = max(gx, gy, gz)

        print(f"g_force={g_force:.2f} g, rotation={rotation:.1f} deg/s")

        if not alarm_active:
            if loop_counter % 10 == 0:
                heartbeat()

            if g_force > 1.2:
                alarm_active = True
                print("⚠️ Alarm aktivován!")
                rled.on()
                buzzer.duty(512)
                gled.off()

                # Po aktivaci alarmu držíme WiFi zapnutou
                wifi_timer = WIFI_KEEP_ON

                send_ntfy(title="Detekován pád", message=f"g_force={g_force:.2f} g")
        else:
            rled.on()
            buzzer.duty(512)
            gled.off()

        loop_counter = (loop_counter + 1) % 10000

        # Správa WiFi po alarmu
        if wifi_timer > 0:
            wifi_timer -= 0.2  # snížení timeru podle sleep
        else:
            disconnect_wifi()

        sleep(0.2)

except KeyboardInterrupt:
    print("Ukončeno")
    rled.off()
    buzzer.duty(0)
    gled.off()
    disconnect_wifi()
